<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon foreground: the split-hexagon mark from ic_askit_launcher.png, traced
  as a vector (source art is 289 px; the mark spans x/y 72..216). Scaled by 0.32 and centred in
  the 108dp adaptive canvas, so it sits well inside the 66dp safe zone. Also used as the
  monochrome (themed icon) layer, where the launcher supplies the tint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.32"
        android:scaleY="0.32"
        android:translateX="7.92"
        android:translateY="7.92">
        <path
            android:fillColor="#FF141414"
            android:strokeColor="#FF141414"
            android:strokeWidth="6"
            android:strokeLineJoin="round"
            android:pathData="M75,107.5 L133,77 L133,211 L75,180.5 Z" />
        <path
            android:fillColor="#FF141414"
            android:strokeColor="#FF141414"
            android:strokeWidth="6"
            android:strokeLineJoin="round"
            android:pathData="M213,107.5 L155,77 L155,211 L213,180.5 Z" />
    </group>
</vector>
